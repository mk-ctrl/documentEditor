# Copy to .env and fill in from Supabase → Project Settings → API Keys.

# Browser-safe (React app, login only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only (Express). The secret key bypasses RLS, so never expose it to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Shared password for the seeded demo users (alice/bob/carol)
DEMO_USER_PASSWORD=change-me-123

# Optional: one-click demo sign-in on the login page (same value as DEMO_USER_PASSWORD)
VITE_DEMO_PASSWORD=change-me-123
